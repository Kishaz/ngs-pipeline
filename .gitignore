# macOS
.DS_Store
**/.DS_Store

# Pipeline outputs / run artifacts
results/
results_*/
.snakemake/

# Large reference data (public reference files — not versioned). References are
# shared and never cloned; ignore everything under resources/ so a 60 GB build
# can't be accidentally `git add`-ed. Keep only the small lab logo the PDF
# reports embed.
resources/*
!resources/Lab_Logo.png

# Local editor / assistant settings
.claude/settings.local.json

# Python
__pycache__/
*.pyc
*.pyo

# Logs
*.log

# Auto-generated results_dir marker
.results_dir

# Published deliverables (copied from scratch on success)
deliverables/
